<!-- Monitor-Layout für den GDM-Anmeldebildschirm (aus ~/.config/monitors.xml).
     <primary>yes</primary> = Monitor, auf dem der Login erscheint -> linker LG (DP-8).
     Eingebunden über systemd.tmpfiles in configuration.nix. -->
<monitors version="2">
  <!-- Laptop offen: 2x LG oben, Laptop darunter -->
  <configuration>
    <layoutmode>logical</layoutmode>
    <logicalmonitor>
      <x>0</x>
      <y>1440</y>
      <scale>1.25</scale>
      <monitor>
        <monitorspec>
          <connector>eDP-1</connector>
          <vendor>AUO</vendor>
          <product>0x573d</product>
          <serial>0x00000000</serial>
        </monitorspec>
        <mode>
          <width>1920</width>
          <height>1080</height>
          <rate>60.033</rate>
        </mode>
      </monitor>
    </logicalmonitor>
    <logicalmonitor>
      <x>2560</x>
      <y>0</y>
      <scale>1</scale>
      <monitor>
        <monitorspec>
          <connector>DP-6</connector>
          <vendor>GSM</vendor>
          <product>LG ULTRAGEAR</product>
          <serial>409NTPC7K824</serial>
        </monitorspec>
        <mode>
          <width>2560</width>
          <height>1440</height>
          <rate>143.991</rate>
        </mode>
      </monitor>
    </logicalmonitor>
    <logicalmonitor>
      <x>0</x>
      <y>0</y>
      <scale>1</scale>
      <primary>yes</primary>
      <monitor>
        <monitorspec>
          <connector>DP-8</connector>
          <vendor>GSM</vendor>
          <product>LG ULTRAGEAR</product>
          <serial>409NTTQ7K833</serial>
        </monitorspec>
        <mode>
          <width>2560</width>
          <height>1440</height>
          <rate>143.973</rate>
        </mode>
      </monitor>
    </logicalmonitor>
  </configuration>
  <!-- Laptop zugeklappt: nur die zwei LG -->
  <configuration>
    <layoutmode>logical</layoutmode>
    <logicalmonitor>
      <x>2560</x>
      <y>0</y>
      <scale>1</scale>
      <monitor>
        <monitorspec>
          <connector>DP-6</connector>
          <vendor>GSM</vendor>
          <product>LG ULTRAGEAR</product>
          <serial>409NTPC7K824</serial>
        </monitorspec>
        <mode>
          <width>2560</width>
          <height>1440</height>
          <rate>143.991</rate>
        </mode>
      </monitor>
    </logicalmonitor>
    <logicalmonitor>
      <x>0</x>
      <y>0</y>
      <scale>1</scale>
      <primary>yes</primary>
      <monitor>
        <monitorspec>
          <connector>DP-8</connector>
          <vendor>GSM</vendor>
          <product>LG ULTRAGEAR</product>
          <serial>409NTTQ7K833</serial>
        </monitorspec>
        <mode>
          <width>2560</width>
          <height>1440</height>
          <rate>143.973</rate>
        </mode>
      </monitor>
    </logicalmonitor>
  </configuration>
</monitors>
